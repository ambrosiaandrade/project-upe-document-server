#!/bin/sh

# Read the commit message from the file passed as an argument
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# --- SKIP VALIDATION FOR MERGE COMMITS ---
if echo "$COMMIT_MSG" | grep -qE "^Merge "; then
  exit 0
fi

# Regex for Conventional Commits standard
CONVENTIONAL_COMMIT_REGEX="^(feat|fix|refactor|style|docs|test|chore)(\(.+\))?!?: .+"

# --- VALIDATIONS ---

# 1. Validate Conventional Commit Format
if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_COMMIT_REGEX"; then
  echo "ERROR: Your commit message does not follow the Conventional Commits format." >&2
  echo "" >&2
  echo "  Please use the format: <type>: <description>" >&2
  echo "  Allowed types: feat, fix, refactor, style, docs, test, chore" >&2
  echo "" >&2
  echo "  Example: feat: Add user authentication endpoint" >&2
  echo "" >&2
  exit 1
fi

# 2. Validate for English (non-ASCII characters)
# The ` -v` inverts the match, so it will find any line that contains non-ASCII characters.
if echo "$COMMIT_MSG" | grep -qP "[\\x80-\\xFF]"; then
  echo "ERROR: Your commit message contains non-ASCII characters." >&2
  echo "" >&2
  echo "  Please use only English characters in commit messages." >&2
  echo "" >&2
  exit 1
fi

# If both checks pass, the commit is allowed
exit 0
